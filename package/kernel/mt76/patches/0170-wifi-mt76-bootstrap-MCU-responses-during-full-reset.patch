From e2748160554e25b7460e55b31a20c3724f2c233d Mon Sep 17 00:00:00 2001
From: Yanghan Ye <yyh94306@gmail.com>
Date: Sun, 30 Aug 2026 01:34:57 +0800
Subject: [PATCH] wifi: mt76: bootstrap MCU responses during full reset

Keep data producers stopped during a full reset, but temporarily restore
the two MCU receive NAPI instances and the IRQ tasklet before firmware
reload. Clear MCU_RESET before scheduling either consumer so synchronous
firmware commands can receive their replies.

On every failure, stop WED, mask PCI interrupts, disable the bootstrap
consumers, disable WFDMA without resetting it, and restore all reset bits.
Purge stale MCU responses before each retry. The four-bit sequence number
cannot then match a delayed response from an earlier attempt.

Signed-off-by: Yanghan Ye <yyh94306@gmail.com>
---
 mt7996/mac.c | 91 ++++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 91 insertions(+)

diff --git a/mt7996/mac.c b/mt7996/mac.c
index 7c40851..e21983d 100644
--- a/mt7996/mac.c
+++ b/mt7996/mac.c
@@ -2148,6 +2148,92 @@ void mt7996_tx_token_put(struct mt7996_dev *dev)
 	}
 }
 
+static void mt7996_mac_restart_mcu_enable(struct mt7996_dev *dev)
+{
+	static const enum mt76_rxq_id mcu_qid[] = {
+		MT_RXQ_MCU,
+		MT_RXQ_MCU_WA,
+	};
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(mcu_qid); i++) {
+		int qid = mcu_qid[i];
+
+		if (!test_bit(qid, &dev->napi_restore) ||
+		    !test_bit(qid, &dev->mt76.napi_registered))
+			continue;
+
+		mt76_napi_enable(&dev->mt76, qid, &dev->mt76.napi[qid]);
+	}
+
+	clear_bit(MT76_MCU_RESET, &dev->mphy.state);
+
+	if (dev->irq_tasklet_disabled) {
+		dev->irq_tasklet_disabled = false;
+		tasklet_enable(&dev->mt76.irq_tasklet);
+		tasklet_schedule(&dev->mt76.irq_tasklet);
+	}
+
+	for (i = 0; i < ARRAY_SIZE(mcu_qid); i++) {
+		int qid = mcu_qid[i];
+
+		if (!test_bit(qid, &dev->napi_restore) ||
+		    !test_bit(qid, &dev->mt76.napi_registered))
+			continue;
+
+		local_bh_disable();
+		napi_schedule(&dev->mt76.napi[qid]);
+		local_bh_enable();
+	}
+}
+
+static void mt7996_mac_restart_mcu_disable(struct mt7996_dev *dev)
+{
+	static const enum mt76_rxq_id mcu_qid[] = {
+		MT_RXQ_MCU,
+		MT_RXQ_MCU_WA,
+	};
+	struct mt7996_phy *phy;
+	u32 irqmask;
+	int i;
+
+	set_bit(MT76_MCU_RESET, &dev->mphy.state);
+	wake_up(&dev->mt76.mcu.wait);
+	mt7996_for_each_phy(dev, phy)
+		set_bit(MT76_RESET, &phy->mt76->state);
+
+	mt76_npu_disable_irqs(&dev->mt76);
+	irqmask = READ_ONCE(dev->mt76.mmio.irqmask);
+	mt7996_irq_disable(dev, ~0);
+	if (dev_is_pci(dev->mt76.dev)) {
+		mt76_wr(dev, MT_PCIE_MAC_INT_ENABLE, 0);
+		if (dev->hif2)
+			mt76_wr(dev, MT_PCIE1_MAC_INT_ENABLE, 0);
+	}
+	if (!dev->irq_tasklet_disabled) {
+		tasklet_disable(&dev->mt76.irq_tasklet);
+		dev->irq_tasklet_disabled = true;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(mcu_qid); i++) {
+		int qid = mcu_qid[i];
+
+		if (test_bit(qid, &dev->mt76.napi_registered))
+			mt76_napi_disable(&dev->mt76, qid,
+					  &dev->mt76.napi[qid]);
+	}
+	if (mtk_wed_device_active(&dev->mt76.mmio.wed_hif2))
+		mtk_wed_device_stop(&dev->mt76.mmio.wed_hif2);
+	if (mtk_wed_device_active(&dev->mt76.mmio.wed))
+		mtk_wed_device_stop(&dev->mt76.mmio.wed);
+
+	/* NAPI completion can briefly re-enable an interrupt while stopping. */
+	mt7996_irq_disable(dev, ~0);
+	WRITE_ONCE(dev->mt76.mmio.irqmask, irqmask);
+	mt7996_dma_disable(dev, false);
+	clear_bit(MT76_STATE_MCU_RUNNING, &dev->mphy.state);
+}
+
 static int
 mt7996_mac_restart(struct mt7996_dev *dev)
 {
@@ -2191,6 +2277,7 @@ mt7996_mac_restart(struct mt7996_dev *dev)
 	mt7996_tx_token_put(dev);
 	idr_init(&dev->mt76.token);
 
+	skb_queue_purge(&mdev->mcu.res_q);
 	mt7996_dma_reset(dev, true);
 
 	clear_bit(MT76_STATE_MCU_RUNNING, &dev->mphy.state);
@@ -2206,6 +2293,7 @@ mt7996_mac_restart(struct mt7996_dev *dev)
 		if (dev->hif2)
 			mt76_wr(dev, MT_PCIE1_MAC_INT_ENABLE, 0xff);
 	}
+	mt7996_mac_restart_mcu_enable(dev);
 
 	/* load firmware */
 	ret = mt7996_mcu_init_firmware(dev);
@@ -2264,6 +2352,9 @@ mt7996_mac_restart(struct mt7996_dev *dev)
 	}
 
 out:
+	if (ret)
+		mt7996_mac_restart_mcu_disable(dev);
+
 	return ret;
 }
 
