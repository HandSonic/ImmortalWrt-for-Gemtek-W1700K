From 028d853d1e5bc51b73aaee36c7e88235bfa14a4d Mon Sep 17 00:00:00 2001
From: Yanghan Ye <yyh94306@gmail.com>
Date: Sat, 29 Aug 2026 22:13:25 +0800
Subject: [PATCH] wifi: mt76: gate NPU queue MMIO through the provider

NPU queue access currently dereferences the provider regmap directly.
That bypasses the provider terminal state and can race a hard-stop reset.

Route queue reads and writes through provider accessors. Both mt76 call
sites already hold rcu_read_lock(), so the provider can check stopped in
the same RCU epoch. Hard stop publishes stopped and uses synchronize_rcu()
to drain all in-flight queue MMIO before asserting reset.

This preserves the lockless steady-state queue path.

Signed-off-by: Yanghan Ye <yyh94306@gmail.com>
---
 dma.h | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/dma.h b/dma.h
index ffd81bb..6f4a036 100644
--- a/dma.h
+++ b/dma.h
@@ -66,7 +66,8 @@ mt76_dma_handle_read(struct mt76_queue *q, u32 offset, u32 *val)
 		rcu_read_lock();
 		npu = rcu_dereference(q->dev->mmio.npu);
 		if (npu)
-			regmap_read(npu->regmap, q->wed_regs + offset, val);
+			airoha_npu_wlan_queue_read(npu, q->wed_regs + offset,
+						   val);
 		rcu_read_unlock();
 
 		return true;
@@ -93,7 +94,8 @@ mt76_dma_handle_write(struct mt76_queue *q, u32 offset, u32 val)
 		rcu_read_lock();
 		npu = rcu_dereference(q->dev->mmio.npu);
 		if (npu)
-			regmap_write(npu->regmap, q->wed_regs + offset, val);
+			airoha_npu_wlan_queue_write(npu, q->wed_regs + offset,
+						    val);
 		rcu_read_unlock();
 
 		return true;
