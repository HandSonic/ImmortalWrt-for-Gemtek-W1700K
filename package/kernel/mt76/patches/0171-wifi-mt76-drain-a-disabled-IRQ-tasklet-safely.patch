From af491f372535d46e46f5b254babd749f4c8b5ffa Mon Sep 17 00:00:00 2001
From: Yanghan Ye <yyh94306@gmail.com>
Date: Sun, 30 Aug 2026 01:36:04 +0800
Subject: [PATCH] wifi: mt76: drain a disabled IRQ tasklet safely

A disabled tasklet with TASKLET_STATE_SCHED set cannot clear its state.
Therefore tasklet_kill() can wait forever during terminal teardown.

Serialize every tasklet state transition with a dedicated mutex. Reset
failure and terminal teardown can no longer increment the disable count at
the same time. Reassert MCU_RESET when terminal teardown wins a bootstrap
race, without adding a reverse lock order.

Make terminal IRQ and tasklet callbacks return without hardware access.
After a successful DMA fence, first free and synchronize the PCI IRQs.
Then enable a disabled pending tasklet before it is killed. Do not kill it
on the noreturn hard-fence failure path.

Signed-off-by: Yanghan Ye <yyh94306@gmail.com>
---
 mt7996/init.c   | 86 ++++++++++++++++++++++++++++++++++++++++---------
 mt7996/mac.c    | 28 ++++++++--------
 mt7996/mmio.c   |  5 +++
 mt7996/mt7996.h |  5 +++
 4 files changed, 95 insertions(+), 29 deletions(-)

diff --git a/mt7996/init.c b/mt7996/init.c
index dc10c56..4926685 100644
--- a/mt7996/init.c
+++ b/mt7996/init.c
@@ -1894,6 +1894,7 @@ int mt7996_register_device(struct mt7996_dev *dev)
 	INIT_WORK(&dev->dump_work, mt7996_mac_dump_work);
 	mutex_init(&dev->dump_mutex);
 	mutex_init(&dev->npu_stop_mutex);
+	mutex_init(&dev->irq_tasklet_mutex);
 
 	ret = mt7996_init_hardware(dev);
 	if (ret)
@@ -1943,6 +1944,59 @@ error:
 	return ret;
 }
 
+void mt7996_irq_tasklet_disable(struct mt7996_dev *dev)
+{
+	mutex_lock(&dev->irq_tasklet_mutex);
+	if (READ_ONCE(dev->terminal)) {
+		set_bit(MT76_MCU_RESET, &dev->mphy.state);
+		wake_up(&dev->mt76.mcu.wait);
+	}
+	if (!dev->irq_tasklet_disabled) {
+		tasklet_disable(&dev->mt76.irq_tasklet);
+		dev->irq_tasklet_disabled = true;
+	}
+	mutex_unlock(&dev->irq_tasklet_mutex);
+}
+
+bool mt7996_irq_tasklet_enable(struct mt7996_dev *dev)
+{
+	bool enabled = false;
+
+	mutex_lock(&dev->irq_tasklet_mutex);
+	if (!READ_ONCE(dev->terminal) && dev->irq_tasklet_disabled) {
+		dev->irq_tasklet_disabled = false;
+		tasklet_enable(&dev->mt76.irq_tasklet);
+		enabled = true;
+	}
+	mutex_unlock(&dev->irq_tasklet_mutex);
+
+	return enabled;
+}
+
+int mt7996_irq_tasklet_bootstrap(struct mt7996_dev *dev)
+{
+	bool enabled = false;
+	int ret = 0;
+
+	mutex_lock(&dev->irq_tasklet_mutex);
+	if (READ_ONCE(dev->terminal)) {
+		ret = -ESHUTDOWN;
+	} else {
+		clear_bit(MT76_MCU_RESET, &dev->mphy.state);
+		if (dev->irq_tasklet_disabled) {
+			dev->irq_tasklet_disabled = false;
+			tasklet_enable(&dev->mt76.irq_tasklet);
+			enabled = true;
+		}
+	}
+	mutex_unlock(&dev->irq_tasklet_mutex);
+
+	if (enabled)
+		tasklet_schedule(&dev->mt76.irq_tasklet);
+
+	return ret;
+}
+
 void mt7996_npu_pre_stop(struct mt7996_dev *dev)
 {
 	struct mt7996_phy *phy;
@@ -1978,10 +2032,7 @@ void mt7996_npu_pre_stop(struct mt7996_dev *dev)
 	irqmask = READ_ONCE(dev->mt76.mmio.irqmask);
 	mt7996_irq_disable(dev, ~0);
 	WRITE_ONCE(dev->mt76.mmio.irqmask, irqmask);
-	if (!dev->irq_tasklet_disabled) {
-		tasklet_disable(&dev->mt76.irq_tasklet);
-		dev->irq_tasklet_disabled = true;
-	}
+	mt7996_irq_tasklet_disable(dev);
 
 	for (i = 0; i < __MT_RXQ_MAX; i++) {
 		if (test_bit(i, &dev->mt76.napi_registered))
@@ -2029,11 +2080,8 @@ void mt7996_npu_post_reset(struct mt7996_dev *dev)
 		local_bh_enable();
 	}
 
-	if (dev->irq_tasklet_disabled) {
-		dev->irq_tasklet_disabled = false;
-		tasklet_enable(&dev->mt76.irq_tasklet);
+	if (mt7996_irq_tasklet_enable(dev))
 		tasklet_schedule(&dev->mt76.irq_tasklet);
-	}
 	mt76_worker_enable(&dev->mt76.tx_worker);
 
 	dev->napi_restore = 0;
@@ -2072,7 +2120,6 @@ void mt7996_terminal_quiesce(struct mt7996_dev *dev)
 void mt7996_quarantine_device(struct mt7996_dev *dev)
 {
 	mt7996_terminal_quiesce(dev);
-	tasklet_kill(&dev->mt76.irq_tasklet);
 }
 
 void __noreturn mt7996_fence_failed(struct mt7996_dev *dev,
@@ -2083,9 +2130,23 @@ void __noreturn mt7996_fence_failed(struct mt7996_dev *dev,
 	      dev_name(dev->mt76.dev), phase, err);
 }
 
-void mt7996_cleanup_device(struct mt7996_dev *dev)
+static void mt7996_free_irqs_and_kill_tasklet(struct mt7996_dev *dev)
 {
 	mt7996_free_irqs(dev);
+
+	/* A disabled, scheduled tasklet cannot clear TASKLET_STATE_SCHED. */
+	mutex_lock(&dev->irq_tasklet_mutex);
+	if (dev->irq_tasklet_disabled) {
+		dev->irq_tasklet_disabled = false;
+		tasklet_enable(&dev->mt76.irq_tasklet);
+	}
+	tasklet_kill(&dev->mt76.irq_tasklet);
+	mutex_unlock(&dev->irq_tasklet_mutex);
+}
+
+void mt7996_cleanup_device(struct mt7996_dev *dev)
+{
+	mt7996_free_irqs_and_kill_tasklet(dev);
 	mt7996_unregister_phy(mt7996_phy3(dev));
 	mt7996_unregister_phy(mt7996_phy2(dev));
 	mt7996_unregister_thermal(&dev->phy);
@@ -2112,11 +2173,6 @@ void mt7996_cleanup_device(struct mt7996_dev *dev)
 		mt7996_rro_msdu_page_map_free(dev);
 		dev->rro_hw_initialized = false;
 	}
-	if (!dev->irq_tasklet_disabled) {
-		tasklet_disable(&dev->mt76.irq_tasklet);
-		dev->irq_tasklet_disabled = true;
-	}
-	tasklet_kill(&dev->mt76.irq_tasklet);
 }
 
 void mt7996_free_irqs(struct mt7996_dev *dev)
diff --git a/mt7996/mac.c b/mt7996/mac.c
index e21983d..6a7af8d 100644
--- a/mt7996/mac.c
+++ b/mt7996/mac.c
@@ -2148,13 +2148,16 @@ void mt7996_tx_token_put(struct mt7996_dev *dev)
 	}
 }
 
-static void mt7996_mac_restart_mcu_enable(struct mt7996_dev *dev)
+static int mt7996_mac_restart_mcu_enable(struct mt7996_dev *dev)
 {
 	static const enum mt76_rxq_id mcu_qid[] = {
 		MT_RXQ_MCU,
 		MT_RXQ_MCU_WA,
 	};
-	int i;
+	int i, ret;
+
+	if (READ_ONCE(dev->terminal))
+		return -ESHUTDOWN;
 
 	for (i = 0; i < ARRAY_SIZE(mcu_qid); i++) {
 		int qid = mcu_qid[i];
@@ -2166,13 +2169,9 @@ static void mt7996_mac_restart_mcu_enable(struct mt7996_dev *dev)
 		mt76_napi_enable(&dev->mt76, qid, &dev->mt76.napi[qid]);
 	}
 
-	clear_bit(MT76_MCU_RESET, &dev->mphy.state);
-
-	if (dev->irq_tasklet_disabled) {
-		dev->irq_tasklet_disabled = false;
-		tasklet_enable(&dev->mt76.irq_tasklet);
-		tasklet_schedule(&dev->mt76.irq_tasklet);
-	}
+	ret = mt7996_irq_tasklet_bootstrap(dev);
+	if (ret)
+		return ret;
 
 	for (i = 0; i < ARRAY_SIZE(mcu_qid); i++) {
 		int qid = mcu_qid[i];
@@ -2185,6 +2184,8 @@ static void mt7996_mac_restart_mcu_enable(struct mt7996_dev *dev)
 		napi_schedule(&dev->mt76.napi[qid]);
 		local_bh_enable();
 	}
+
+	return 0;
 }
 
 static void mt7996_mac_restart_mcu_disable(struct mt7996_dev *dev)
@@ -2210,10 +2211,7 @@ static void mt7996_mac_restart_mcu_disable(struct mt7996_dev *dev)
 		if (dev->hif2)
 			mt76_wr(dev, MT_PCIE1_MAC_INT_ENABLE, 0);
 	}
-	if (!dev->irq_tasklet_disabled) {
-		tasklet_disable(&dev->mt76.irq_tasklet);
-		dev->irq_tasklet_disabled = true;
-	}
+	mt7996_irq_tasklet_disable(dev);
 
 	for (i = 0; i < ARRAY_SIZE(mcu_qid); i++) {
 		int qid = mcu_qid[i];
@@ -2293,7 +2291,9 @@ mt7996_mac_restart(struct mt7996_dev *dev)
 		if (dev->hif2)
 			mt76_wr(dev, MT_PCIE1_MAC_INT_ENABLE, 0xff);
 	}
-	mt7996_mac_restart_mcu_enable(dev);
+	ret = mt7996_mac_restart_mcu_enable(dev);
+	if (ret)
+		goto out;
 
 	/* load firmware */
 	ret = mt7996_mcu_init_firmware(dev);
diff --git a/mt7996/mmio.c b/mt7996/mmio.c
index e02724a..3242b83 100644
--- a/mt7996/mmio.c
+++ b/mt7996/mmio.c
@@ -724,6 +724,9 @@ static void mt7996_irq_tasklet(struct tasklet_struct *t)
 	struct mtk_wed_device *wed_hif2 = &dev->mt76.mmio.wed_hif2;
 	u32 i, intr, mask, intr1 = 0;
 
+	if (READ_ONCE(dev->terminal))
+		return;
+
 	if (dev->hif2 && mtk_wed_device_active(wed_hif2)) {
 		mtk_wed_device_irq_set_mask(wed_hif2, 0);
 		intr1 = mtk_wed_device_irq_get(wed_hif2,
@@ -799,6 +802,8 @@ irqreturn_t mt7996_irq_handler(int irq, void *dev_instance)
 		else
 			mt76_wr(dev, MT_INT1_MASK_CSR, 0);
 	}
+	if (READ_ONCE(dev->terminal))
+		return IRQ_HANDLED;
 
 	if (!test_bit(MT76_STATE_INITIALIZED, &dev->mphy.state))
 		return IRQ_NONE;
diff --git a/mt7996/mt7996.h b/mt7996/mt7996.h
index 7d7e7ec..41a7f96 100644
--- a/mt7996/mt7996.h
+++ b/mt7996/mt7996.h
@@ -519,6 +519,8 @@ struct mt7996_dev {
 	struct mutex dump_mutex;
 	/* serializes producer quiesce and restore */
 	struct mutex npu_stop_mutex;
+	/* serializes IRQ tasklet enable state */
+	struct mutex irq_tasklet_mutex;
 #ifdef CONFIG_DEV_COREDUMP
 	struct {
 		struct mt7996_crash_data *crash_data;
@@ -755,6 +757,9 @@ int mt7996_shutdown_device(struct mt7996_dev *dev);
 void mt7996_quarantine_device(struct mt7996_dev *dev);
 void mt7996_npu_pre_stop(struct mt7996_dev *dev);
 void mt7996_npu_post_reset(struct mt7996_dev *dev);
+void mt7996_irq_tasklet_disable(struct mt7996_dev *dev);
+bool mt7996_irq_tasklet_enable(struct mt7996_dev *dev);
+int mt7996_irq_tasklet_bootstrap(struct mt7996_dev *dev);
 void mt7996_terminal_quiesce(struct mt7996_dev *dev);
 void __noreturn mt7996_fence_failed(struct mt7996_dev *dev,
 				    const char *phase, int err);
-- 
