From: Tao Gong <gongtao0607@gmail.com>
Date: Sun, 16 Aug 2026 06:01:01 +0000
Subject: [PATCH] mt76: mt7996: release HW_RRO sessions on teardown

Apple/macOS clients may negotiate RX BlockAck sessions on several TIDs.
When the associated session IDs are only cached in the transient software
reorder context, MT7996/NPU can retain per-WCID RRO state through station
teardown. The next association that reuses the WCID then inherits stale
NPU context and uplink RX no longer reaches the PPE unbind path (a
FOE_ID=0 storm).

Persist the firmware-assigned session ID in the station link, clear it
when RX BA stops, and explicitly ask firmware to release that session.
Continue processing remaining session-status events when one TID is
already torn down or belongs to another link.

Signed-off-by: Tao Gong <gongtao0607@gmail.com>
---

--- a/mt7996/main.c
+++ b/mt7996/main.c
@@ -1713,10 +1713,17 @@ mt7996_ampdu_action(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
 				   ssn, params->buf_size);
 		ret = mt7996_mcu_add_rx_ba(dev, params, vif, true);
 		break;
-	case IEEE80211_AMPDU_RX_STOP:
+	case IEEE80211_AMPDU_RX_STOP: {
+		u16 session_id = msta->deflink.rro_id[tid];
+
+		msta->deflink.rro_id[tid] = 0;
 		mt76_rx_aggr_stop(&dev->mt76, &msta->deflink.wcid, tid);
 		ret = mt7996_mcu_add_rx_ba(dev, params, vif, false);
+
+		if (session_id && mt7996_has_hwrro(dev))
+			mt7996_mcu_wed_rro_reset_sessions(dev, session_id);
 		break;
+	}
 	case IEEE80211_AMPDU_TX_OPERATIONAL:
 		mtxq->aggr = true;
 		mtxq->send_bar = false;
--- a/mt7996/mcu.c
+++ b/mt7996/mcu.c
@@ -1043,6 +1043,7 @@ mt7996_mcu_wed_rro_event(struct mt7996_dev *dev, struct sk_buff *skb)
 		while (skb->len >= sizeof(*e)) {
 			struct mt76_rx_tid *tid;
 			struct mt76_wcid *wcid;
+			struct mt7996_sta_link *msta_link;
 			u16 idx;
 
 			e = (void *)skb->data;
@@ -1055,10 +1056,19 @@ mt7996_mcu_wed_rro_event(struct mt7996_dev *dev, struct sk_buff *skb)
 				break;
 
 			tid = rcu_dereference(wcid->aggr[e->tid]);
-			if (!tid)
-				break;
+			if (!tid) {
+				/* BA session is not tracked on the primary
+				 * link (secondary link or already torn down);
+				 * keep processing the remaining events.
+				 */
+				skb_pull(skb, sizeof(*e));
+				continue;
+			}
 
 			tid->id = le16_to_cpu(e->id);
+			msta_link = container_of(wcid, struct mt7996_sta_link,
+						 wcid);
+			msta_link->rro_id[e->tid] = tid->id;
 			skb_pull(skb, sizeof(*e));
 		}
 		break;
--- a/mt7996/mt7996.h
+++ b/mt7996/mt7996.h
@@ -300,6 +300,13 @@ struct mt7996_sta_link {
 	unsigned long changed;
 
 	struct mt76_connac_sta_key_conf bip;
+	/* firmware-assigned HW_RRO session id per RX TID, reported by the
+	 * UNI_WED_RRO_BA_SESSION_STATUS event; consumed at BA teardown to
+	 * release the firmware-side session.  Written from the WED RRO event
+	 * handler, read/cleared under dev->mt76.mutex in the BA teardown
+	 * path.
+	 */
+	u16 rro_id[IEEE80211_NUM_TIDS];
 
 	struct {
 		u8 flowid_mask;
