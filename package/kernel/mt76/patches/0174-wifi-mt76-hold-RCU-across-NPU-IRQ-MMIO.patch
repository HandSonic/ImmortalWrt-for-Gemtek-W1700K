From 799d48719dcc18a5d18d2ede1bf722a0b11ca2e7 Mon Sep 17 00:00:00 2001
From: OpenAI Codex <codex@openai.com>
Date: Sun, 30 Aug 2026 18:21:22 +0800
Subject: [PATCH] wifi: mt76: hold RCU across NPU IRQ MMIO

The NPU provider uses its hard-stop RCU grace period to fence WLAN IRQ
register access without a shared hot-path lock.

Cover the teardown and initialization call sites that previously relied
only on the mt76 mutex. Keep the read-side sections away from operations
that can sleep.

Signed-off-by: OpenAI Codex <codex@openai.com>
---
 mt7996/npu.c | 2 ++
 npu.c        | 4 ++++
 2 files changed, 6 insertions(+)

diff --git a/mt7996/npu.c b/mt7996/npu.c
index 208ff8a..14492e1 100644
--- a/mt7996/npu.c
+++ b/mt7996/npu.c
@@ -546,8 +546,10 @@ static int mt7996_npu_hw_init_once(struct mt7996_dev *dev,
 	if (err)
 		return err;
 
+	rcu_read_lock();
 	for (i = MT_RXQ_NPU0; i <= MT_RXQ_NPU1; i++)
 		airoha_npu_wlan_enable_irq(npu, i - MT_RXQ_NPU0);
+	rcu_read_unlock();
 
 	return 0;
 }
diff --git a/npu.c b/npu.c
index 39a10bd..84cbdb3 100644
--- a/npu.c
+++ b/npu.c
@@ -379,9 +379,11 @@ void mt76_npu_rx_queues_deinit(struct mt76_dev *dev)
 		if (irq_registered) {
 			WRITE_ONCE(q->npu_irq_registered, false);
 			if (npu) {
+				rcu_read_lock();
 				status = airoha_npu_wlan_get_irq_status(npu, index);
 				airoha_npu_wlan_set_irq_status(npu, status);
 				airoha_npu_wlan_disable_irq(npu, index);
+				rcu_read_unlock();
 			}
 
 			devm_free_irq(dev->dev, q->npu_irq, q);
@@ -394,9 +396,11 @@ void mt76_npu_rx_queues_deinit(struct mt76_dev *dev)
 
 		/* A poll already completing can race the first IRQ mask. */
 		if (npu && (irq_registered || napi_registered)) {
+			rcu_read_lock();
 			status = airoha_npu_wlan_get_irq_status(npu, index);
 			airoha_npu_wlan_set_irq_status(npu, status);
 			airoha_npu_wlan_disable_irq(npu, index);
+			rcu_read_unlock();
 		}
 
 		if (q->page_pool) {
