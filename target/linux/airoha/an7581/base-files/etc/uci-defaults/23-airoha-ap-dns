#!/bin/sh

# dhcp.lan.ignore is the explicit dumb-AP marker used by the Airoha status
# services. In that mode clients may use DNS servers supplied by an upstream
# router, so dnsmasq must not redirect transit DNS to the local instance.

[ "$(uci -q get dhcp.lan.ignore)" = "1" ] || exit 0

uci -q set dhcp.@dnsmasq[0].dns_redirect='0'
uci -q commit dhcp

exit 0
