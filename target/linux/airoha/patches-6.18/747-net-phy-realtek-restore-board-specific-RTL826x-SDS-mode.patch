From: OpenAI Codex <codex@openai.com>
Date: Sun, 23 Aug 2026 23:40:00 +0800
Subject: [PATCH] net: phy: realtek: restore board-specific RTL826x SDS mode

The RTL826x firmware sequence resets and initializes the host SerDes, so
a board-specific value installed by the bootloader does not survive Linux
PHY initialization.  The Gemtek XR1710G vendor setup programs SDS page 6,
register 3 to 0x88c6; the W1700K uses the same phy5 wiring.

Add an optional realtek,sds-mode property and apply it after the generic
firmware sequence.  Reject values wider than the 16-bit SDS register and
fail on SDS write/read errors or an exact readback mismatch.  Silently do
nothing for boards which do not provide the property.

Signed-off-by: OpenAI Codex <codex@openai.com>
---
 Documentation/devicetree/bindings/net/realtek,rtl82xx.yaml |  7 +++++++
 drivers/net/phy/realtek/phy_patch_rtl826x.c                 |  6 +++---
 drivers/net/phy/realtek/phy_patch_rtl826x.h                 |  4 ++++
 drivers/net/phy/realtek/realtek_main.c                      | 58 ++++++++++++++++++++++
 4 files changed, 72 insertions(+), 3 deletions(-)

--- a/Documentation/devicetree/bindings/net/realtek,rtl82xx.yaml
+++ b/Documentation/devicetree/bindings/net/realtek,rtl82xx.yaml
@@ -50,6 +50,13 @@ properties:
     description:
       Enable ALDPS mode, ALDPS mode default is disabled after hardware reset.
 
+  realtek,sds-mode:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    maximum: 65535
+    description: |
+      Board-specific 16-bit host SerDes mode programmed into SDS page 6,
+      register 3 after the RTL825x/RTL826x firmware initialization sequence.
+
   wakeup-source:
     type: boolean
     description:
--- a/drivers/net/phy/realtek/phy_patch_rtl826x.c
+++ b/drivers/net/phy/realtek/phy_patch_rtl826x.c
@@ -70,7 +70,7 @@ static int rtl826x_phy_patch_wait(struct
 	return 0;
 }
 
-static int rtl826x_phy_patch_sds_get(struct phy_device *phydev, u32 sds_page, u32 sds_reg)
+int rtl826x_phy_patch_sds_get(struct phy_device *phydev, u32 sds_page, u32 sds_reg)
 {
 	u32 sds_addr = 0x8000 + (sds_reg << 6) + sds_page;
 	int ret;
@@ -86,8 +86,8 @@ static int rtl826x_phy_patch_sds_get(stru
 	return phy_read_mmd(phydev, MDIO_MMD_VEND1, 0x142);
 }
 
-static int rtl826x_phy_patch_sds_set(struct phy_device *phydev, u32 sds_page, u32 sds_reg,
-				     u32 data)
+int rtl826x_phy_patch_sds_set(struct phy_device *phydev, u32 sds_page,
+			      u32 sds_reg, u32 data)
 {
 	u32 sds_addr = 0x8800 + (sds_reg << 6) + sds_page;
 	int ret;
--- a/drivers/net/phy/realtek/phy_patch_rtl826x.h
+++ b/drivers/net/phy/realtek/phy_patch_rtl826x.h
@@ -5,6 +5,10 @@
 
 #include <linux/phy.h>
 
+int rtl826x_phy_patch_sds_get(struct phy_device *phydev, u32 sds_page,
+			      u32 sds_reg);
+int rtl826x_phy_patch_sds_set(struct phy_device *phydev, u32 sds_page,
+			      u32 sds_reg, u32 data);
 int rtl8261n_phy_patch_db_init(struct phy_device *phydev);
 int rtl8264b_phy_patch_db_init(struct phy_device *phydev);
 
--- a/drivers/net/phy/realtek/realtek_main.c
+++ b/drivers/net/phy/realtek/realtek_main.c
@@ -222,6 +222,9 @@
 #define RTL826X_VEND1_VERSION_ID		0x104
 #define   RTL826X_VEND1_VERSION_ID_VARIANT	GENMASK(2, 0)
 
+#define RTL826X_SDS_HOST_MODE_PAGE		6
+#define RTL826X_SDS_HOST_MODE_REG		3
+
 #define RTL826X_VND2_INER			0xA424
 #define   RTL826X_VND2_INER_LINK_STATUS		BIT(4)
 #define   RTL826X_VND2_INER_PME			BIT(7)
@@ -2397,6 +2400,57 @@ static int rtl826x_probe(struct phy_devic
 	return 0;
 }
 
+static int rtl826x_config_sds_mode(struct phy_device *phydev)
+{
+	struct device *dev = &phydev->mdio.dev;
+	u32 mode;
+	int readback;
+	int ret;
+
+	if (!device_property_present(dev, "realtek,sds-mode"))
+		return 0;
+
+	ret = device_property_read_u32(dev, "realtek,sds-mode", &mode);
+	if (ret) {
+		phydev_err(phydev, "failed to read SDS mode: %d\n", ret);
+		return ret;
+	}
+
+	if (mode > 0xffff) {
+		phydev_err(phydev, "invalid SDS mode 0x%x\n", mode);
+		return -EINVAL;
+	}
+
+	ret = rtl826x_phy_patch_sds_set(phydev,
+					RTL826X_SDS_HOST_MODE_PAGE,
+					RTL826X_SDS_HOST_MODE_REG, mode);
+	if (ret) {
+		phydev_err(phydev, "failed to set SDS mode 0x%04x: %d\n",
+			   mode, ret);
+		return ret;
+	}
+
+	readback = rtl826x_phy_patch_sds_get(phydev,
+					     RTL826X_SDS_HOST_MODE_PAGE,
+					     RTL826X_SDS_HOST_MODE_REG);
+	if (readback < 0) {
+		phydev_err(phydev, "failed to read back SDS mode: %d\n",
+			   readback);
+		return readback;
+	}
+
+	if (readback != mode) {
+		phydev_err(phydev,
+			   "SDS mode readback mismatch: wrote 0x%04x, read 0x%04x\n",
+			   mode, readback);
+		return -EIO;
+	}
+
+	phydev_info(phydev, "configured SDS mode 0x%04x\n", mode);
+
+	return 0;
+}
+
 static int rtl826x_config_serdes_polarity(struct phy_device *phydev)
 {
 	struct device *dev = &phydev->mdio.dev;
@@ -2473,6 +2527,10 @@ static int rtl826x_config_init(struct phy
 		return ret;
 	}
 
+	ret = rtl826x_config_sds_mode(phydev);
+	if (ret)
+		return ret;
+
 	return rtl826x_config_serdes_polarity(phydev);
 }
 
-- 
2.51.0
