+static int
+airoha_ppe_foe_commit_direct_subflow(struct airoha_ppe *ppe,
+				     const struct airoha_foe_entry *bridge,
+				     struct net_device *egress,
+				     u32 hash, u32 index, bool rx_wlan)
+{
+	struct airoha_flow_table_entry *f;
+	int err;
+
+	f = kzalloc(sizeof(*f), GFP_ATOMIC);
+	if (!f) {
+		dev_put(egress);
+		return -ENOMEM;
+	}
+
+	f->direct_dev = egress;
+	err = airoha_ppe_foe_commit_subflow(ppe, bridge, hash, rx_wlan,
+					      &f->data);
+	if (err) {
+		f->direct_dev = NULL;
+		dev_put(egress);
+		kfree(f);
+		return err;
+	}
+
+	f->type = FLOW_TYPE_L2_SUBFLOW;
+	f->hash = hash;
+	hlist_add_head(&f->list, &ppe->foe_flow[index]);
+
+	return 0;
+}
