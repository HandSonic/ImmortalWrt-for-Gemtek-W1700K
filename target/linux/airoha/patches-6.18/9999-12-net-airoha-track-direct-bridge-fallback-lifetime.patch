 EXPORT_SYMBOL_GPL(airoha_ppe_put_dev);
 
+static void airoha_ppe_remove_direct_flows_dev(struct airoha_ppe *ppe,
+					       struct net_device *dev)
+{
+	int num_entries = airoha_ppe_get_total_num_entries(ppe);
+	struct airoha_flow_table_entry *e;
+	struct hlist_node *n;
+	int i;
+
+	spin_lock_bh(&ppe_lock);
+
+	for (i = 0; i < num_entries; i++) {
+		hlist_for_each_entry_safe(e, n, &ppe->foe_flow[i], list) {
+			if (e->type != FLOW_TYPE_L2_SUBFLOW || !e->direct_dev ||
+			    e->direct_dev != dev)
+				continue;
+
+			airoha_ppe_foe_remove_flow(ppe, e);
+		}
+	}
+
+	spin_unlock_bh(&ppe_lock);
+}
+
+static void airoha_ppe_remove_direct_flows(struct airoha_ppe *ppe)
+{
+	int num_entries = airoha_ppe_get_total_num_entries(ppe);
+	struct airoha_flow_table_entry *e;
+	struct hlist_node *n;
+	int i;
+
+	spin_lock_bh(&ppe_lock);
+
+	for (i = 0; i < num_entries; i++) {
+		hlist_for_each_entry_safe(e, n, &ppe->foe_flow[i], list) {
+			if (e->type == FLOW_TYPE_L2_SUBFLOW && e->direct_dev)
+				airoha_ppe_foe_remove_flow(ppe, e);
+		}
+	}
+
+	spin_unlock_bh(&ppe_lock);
+}
+
+static int airoha_ppe_netdev_event(struct notifier_block *nb,
+				   unsigned long event, void *ptr)
+{
+	struct airoha_ppe *ppe = container_of(nb, struct airoha_ppe,
+					      netdev_notifier);
+	struct net_device *dev = netdev_notifier_info_to_dev(ptr);
+
+	switch (event) {
+	case NETDEV_GOING_DOWN:
+	case NETDEV_DOWN:
+	case NETDEV_UNREGISTER:
+		break;
+	default:
+		return NOTIFY_DONE;
+	}
+
+	airoha_ppe_remove_direct_flows_dev(ppe, dev);
+
+	return NOTIFY_DONE;
+}
